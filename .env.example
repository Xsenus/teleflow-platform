# TeleFlow Platform 2.5 — пример для локального запуска.
# Для production используйте deploy/.env.production.example и отдельное хранилище секретов.

# Приложение
TELEFLOW_ENVIRONMENT=development
TELEFLOW_DEBUG=true
TELEFLOW_APP_NAME=TeleFlow Platform
TELEFLOW_VERSION=2.5.0
TELEFLOW_PUBLIC_BASE_URL=http://localhost:8080
TELEFLOW_API_PREFIX=/api/v1

# База данных. В development/test таблицы можно создать автоматически.
TELEFLOW_DATABASE_URL=sqlite:///./data/teleflow.db
TELEFLOW_AUTO_CREATE_SCHEMA=true

# Сгенерировать: python scripts/generate_secrets.py
TELEFLOW_MASTER_KEY=development-only-change-me
TELEFLOW_JWT_SECRET=development-jwt-change-me
TELEFLOW_JWT_ISSUER=teleflow-platform

# Первая организация и владелец
TELEFLOW_BOOTSTRAP_ORGANIZATION_NAME=Основная организация
TELEFLOW_BOOTSTRAP_ORGANIZATION_SLUG=main
TELEFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TELEFLOW_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_123456!
TELEFLOW_BOOTSTRAP_ADMIN_NAME=Владелец

# Browser security
TELEFLOW_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
TELEFLOW_ALLOWED_HOSTS=localhost,127.0.0.1
TELEFLOW_IP_ALLOWLIST=
TELEFLOW_TRUST_PROXY_HEADERS=false
TELEFLOW_COOKIE_SECURE=false
TELEFLOW_COOKIE_SAMESITE=strict
TELEFLOW_ACCESS_TOKEN_MINUTES=15
TELEFLOW_REFRESH_TOKEN_DAYS=7
TELEFLOW_LOGIN_MAX_FAILURES=5
TELEFLOW_LOGIN_LOCK_MINUTES=15
TELEFLOW_REQUIRE_ADMIN_TOTP=false

# Telegram. Fake mode выполняет весь контур без внешних запросов.
TELEFLOW_TELEGRAM_FAKE_MODE=true
TELEFLOW_INBOUND_ENABLED=true
TELEFLOW_WEBHOOK_SECRET_LENGTH=48
TELEFLOW_INBOUND_UPDATE_MAX_BYTES=2097152
TELEFLOW_INBOUND_MESSAGE_MAX_CHARS=12000
TELEFLOW_USER_HARD_MIN_INTERVAL_SECONDS=60
TELEFLOW_BOT_HARD_MIN_INTERVAL_SECONDS=1
TELEFLOW_USER_DEFAULT_INTERVAL_SECONDS=90
TELEFLOW_BOT_DEFAULT_INTERVAL_SECONDS=30
TELEFLOW_DEFAULT_DESTINATION_COOLDOWN_MINUTES=1440
TELEFLOW_GLOBAL_HARD_DAILY_CAP=500

# Governance: явное утверждение, правило четырёх глаз и центр уведомлений
TELEFLOW_NOTIFICATION_DEDUP_MINUTES=10
TELEFLOW_DEFAULT_REQUIRE_DISTINCT_CAMPAIGN_APPROVER=false
TELEFLOW_DEFAULT_HIGH_RISK_DESTINATION_THRESHOLD=20
TELEFLOW_DEFAULT_HIGH_RISK_REQUIRED_APPROVALS=2
TELEFLOW_DEFAULT_APPROVAL_REQUEST_TTL_HOURS=24

# Worker, очередь и Redis-lock
TELEFLOW_WORKER_POLL_SECONDS=2
TELEFLOW_JOB_LEASE_MINUTES=10
# Execution Fencing 2.3: один active site/worker на организацию.
TELEFLOW_EXECUTION_FENCING_REQUIRED=true
TELEFLOW_EXECUTION_SITE_KEY=primary
TELEFLOW_EXECUTION_SITE_NAME=Основная площадка
TELEFLOW_EXECUTION_PRIMARY_SITE_KEY=primary
TELEFLOW_EXECUTION_LEASE_TTL_SECONDS=45
TELEFLOW_EXECUTION_SITE_HEARTBEAT_TTL_SECONDS=90
TELEFLOW_EXECUTION_REQUIRE_DISTINCT_FAILOVER_APPROVER=true

# Continuity Assurance 2.4: simulation/live drill, failback и независимая приёмка.
TELEFLOW_CONTINUITY_ASSURANCE_REQUIRED=false
TELEFLOW_CONTINUITY_REQUIRE_DISTINCT_SIGNOFF=true
TELEFLOW_CONTINUITY_DEFAULT_REQUIRE_LIVE_DRILL=true
TELEFLOW_CONTINUITY_DEFAULT_MAX_RTO_SECONDS=300
TELEFLOW_CONTINUITY_DEFAULT_EVIDENCE_VALID_DAYS=30
TELEFLOW_CONTINUITY_SYNC_INTERVAL_SECONDS=15
TELEFLOW_OUTBOX_POLL_SECONDS=2
TELEFLOW_OUTBOX_LEASE_MINUTES=5
TELEFLOW_REQUIRE_WORKER_FOR_READINESS=false
TELEFLOW_WORKER_READINESS_MAX_AGE_SECONDS=60
TELEFLOW_USE_REDIS_LOCKS=false
TELEFLOW_REDIS_URL=redis://localhost:6379/0

# Local или S3-compatible storage
TELEFLOW_STORAGE_BACKEND=local
TELEFLOW_STORAGE_PATH=./storage
TELEFLOW_MAX_MEDIA_BYTES=20971520
TELEFLOW_MAX_EXPORT_BYTES=52428800
# Optional malware scan before storage: disabled | clamav
TELEFLOW_ANTIVIRUS_MODE=disabled
TELEFLOW_ANTIVIRUS_FAIL_CLOSED=true
TELEFLOW_CLAMAV_HOST=127.0.0.1
TELEFLOW_CLAMAV_PORT=3310
TELEFLOW_CLAMAV_TIMEOUT_SECONDS=8
TELEFLOW_S3_ENDPOINT_URL=
TELEFLOW_S3_REGION=us-east-1
TELEFLOW_S3_BUCKET=
TELEFLOW_S3_ACCESS_KEY=
TELEFLOW_S3_SECRET_KEY=
TELEFLOW_S3_SECURE=true

# AI и автоматизация входящих
TELEFLOW_AI_PROVIDER_ALLOWLIST=rule_based,openai_compatible
TELEFLOW_AI_REQUEST_RATE_PER_MINUTE=30
TELEFLOW_AI_MAX_CONTEXT_MESSAGES=20
TELEFLOW_AI_MAX_CONTEXT_CHARS=16000
TELEFLOW_PII_PREVIEW_LENGTH=240
TELEFLOW_DEFAULT_RETENTION_DAYS=90
TELEFLOW_INBOUND_RAW_RETENTION_DAYS=7
TELEFLOW_PRIVACY_EXPORT_TTL_HOURS=24

# Исходящие integrations: HTTPS и SSRF-защита включены в production
TELEFLOW_WEBHOOK_TIMEOUT_SECONDS=15
TELEFLOW_ALLOW_PRIVATE_INTEGRATION_URLS=false

# Наблюдаемость
TELEFLOW_LOG_LEVEL=INFO
TELEFLOW_LOG_FORMAT=text
TELEFLOW_METRICS_ENABLED=true
TELEFLOW_METRICS_PATH=/metrics
TELEFLOW_SENTRY_DSN=
TELEFLOW_OTEL_ENABLED=false
TELEFLOW_OTEL_SERVICE_NAME=teleflow-platform
TELEFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=

# Pilot Certification 1.5
TELEFLOW_PREFLIGHT_TTL_MINUTES=60
TELEFLOW_PERMISSION_EXPIRY_WARNING_DAYS=14
TELEFLOW_DESTINATION_VALIDATION_TTL_HOURS=168
TELEFLOW_CONNECTION_HEALTH_TTL_HOURS=24
TELEFLOW_READINESS_TTL_MINUTES=30
TELEFLOW_COMMISSIONING_TTL_MINUTES=30
TELEFLOW_CHANGE_VERIFICATION_TTL_MINUTES=30
TELEFLOW_PILOT_READINESS_REQUIRED=false
TELEFLOW_PILOT_STAGED_THRESHOLD=5
TELEFLOW_PILOT_STAGE_ENFORCEMENT_REQUIRED=false
TELEFLOW_PILOT_STAGE_ASSESSMENT_TTL_MINUTES=30
TELEFLOW_PILOT_CANARY_COOLDOWN_HOURS=24
TELEFLOW_PILOT_CANARY_VALID_HOURS=168
TELEFLOW_PILOT_RUN_EVIDENCE_MAX_AGE_DAYS=30
TELEFLOW_PILOT_MAX_FAILURE_PERCENT=10
TELEFLOW_SUPPORT_BUNDLE_TTL_HOURS=24
TELEFLOW_ARTIFACT_SIGNATURE_POLICY=optional
TELEFLOW_REQUIRE_TRUSTED_RELEASE_ATTESTATION=false
TELEFLOW_REQUIRE_RELEASE_TRANSPARENCY=false
TELEFLOW_REQUIRE_DEPENDENCY_ASSESSMENT=false
TELEFLOW_DEPENDENCY_ASSESSMENT_TTL_HOURS=24
TELEFLOW_DEPENDENCY_REQUIRE_VULNERABILITY_SCAN=false
TELEFLOW_DEPENDENCY_REQUIRE_TRUSTED_REPORT=false
TELEFLOW_DEPENDENCY_REPORT_MAX_BYTES=5242880

# Operational SLO & Incident Assurance 2.2
TELEFLOW_SLO_GATE_REQUIRED=false
TELEFLOW_SLO_AUTO_EVALUATE_MINUTES=15
TELEFLOW_SLO_ASSESSMENT_TTL_MINUTES=30
TELEFLOW_SLO_DEFAULT_EVALUATION_WINDOW_HOURS=24
TELEFLOW_SLO_DEFAULT_DELIVERY_SUCCESS_TARGET_BPS=9900
TELEFLOW_SLO_DEFAULT_MINIMUM_DELIVERY_SAMPLE_SIZE=10
TELEFLOW_SLO_DEFAULT_MAX_QUEUE_AGE_SECONDS=900
TELEFLOW_SLO_DEFAULT_MAX_WORKER_HEARTBEAT_AGE_SECONDS=120
TELEFLOW_SLO_DEFAULT_MAX_UNRESOLVED_DELIVERY_REVIEWS=0
TELEFLOW_SLO_DEFAULT_MAX_OPEN_CRITICAL_INCIDENTS=0
TELEFLOW_SLO_DEFAULT_ERROR_BUDGET_WARNING_PERCENT=50
TELEFLOW_SLO_DEFAULT_ERROR_BUDGET_CRITICAL_PERCENT=100

# Capacity & Backpressure Assurance 2.5
TELEFLOW_CAPACITY_ASSURANCE_REQUIRED=false
TELEFLOW_CAPACITY_AUTO_EVALUATE_MINUTES=5
TELEFLOW_CAPACITY_ASSESSMENT_TTL_MINUTES=15
TELEFLOW_CAPACITY_DEFAULT_MAX_ACTIVE_JOBS=500
TELEFLOW_CAPACITY_DEFAULT_MAX_READY_JOBS=100
TELEFLOW_CAPACITY_DEFAULT_MAX_PROCESSING_JOBS=5
TELEFLOW_CAPACITY_DEFAULT_MAX_ACTIVE_RUNS=20
TELEFLOW_CAPACITY_DEFAULT_MAX_JOBS_PER_RUN=100
TELEFLOW_CAPACITY_DEFAULT_MAX_NETWORK_STARTS_PER_MINUTE=30
TELEFLOW_CAPACITY_DEFAULT_MAX_NETWORK_STARTS_PER_HOUR=500
TELEFLOW_CAPACITY_DEFAULT_MAX_ESTIMATED_DRAIN_SECONDS=21600
TELEFLOW_CAPACITY_DEFAULT_WARNING_UTILIZATION_PERCENT=70
TELEFLOW_CAPACITY_DEFAULT_ADMISSION_BLOCK_UTILIZATION_PERCENT=90
TELEFLOW_CAPACITY_RETRY_DELAY_SECONDS=15

# Recovery Assurance 1.8
TELEFLOW_RECOVERY_DEFAULT_RPO_HOURS=24
TELEFLOW_RECOVERY_DEFAULT_RTO_MINUTES=60
TELEFLOW_RECOVERY_DEFAULT_DRILL_MAX_AGE_DAYS=30
TELEFLOW_RECOVERY_DEFAULT_MINIMUM_RETAINED_BACKUPS=3
TELEFLOW_RECOVERY_EVIDENCE_RETENTION_DAYS=365
TELEFLOW_RECOVERY_REQUIRE_ENCRYPTED_BACKUP=false
TELEFLOW_RECOVERY_REQUIRE_TRUSTED_SIGNATURE=false
# Public age recipient used for encryption. Keep the private identity outside the backup.
TELEFLOW_RECOVERY_AGE_RECIPIENT=
TELEFLOW_RECOVERY_AGE_IDENTITY_FILE=

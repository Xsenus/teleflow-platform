# Скопируйте в закрытый .env и замените ВСЕ значения CHANGE_ME.
TELEFLOW_ENVIRONMENT=production
TELEFLOW_DEBUG=false
TELEFLOW_VERSION=2.5.0
TELEFLOW_PUBLIC_BASE_URL=https://panel.example.com
TELEFLOW_DATABASE_URL=postgresql+psycopg://teleflow:CHANGE_ME_DB_PASSWORD@db:5432/teleflow
TELEFLOW_AUTO_CREATE_SCHEMA=false
TELEFLOW_MASTER_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
TELEFLOW_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
TELEFLOW_BOOTSTRAP_ORGANIZATION_NAME=Основная организация
TELEFLOW_BOOTSTRAP_ORGANIZATION_SLUG=main
TELEFLOW_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
TELEFLOW_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD
TELEFLOW_BOOTSTRAP_ADMIN_NAME=Владелец
TELEFLOW_TELEGRAM_FAKE_MODE=false
# Production: владелец запроса не утверждает собственную кампанию.
TELEFLOW_DEFAULT_REQUIRE_DISTINCT_CAMPAIGN_APPROVER=true
TELEFLOW_DEFAULT_HIGH_RISK_DESTINATION_THRESHOLD=20
TELEFLOW_DEFAULT_HIGH_RISK_REQUIRED_APPROVALS=2
TELEFLOW_DEFAULT_APPROVAL_REQUEST_TTL_HOURS=24
TELEFLOW_NOTIFICATION_DEDUP_MINUTES=10
TELEFLOW_REQUIRE_ADMIN_TOTP=true
TELEFLOW_REQUIRE_WORKER_FOR_READINESS=true
TELEFLOW_EXECUTION_FENCING_REQUIRED=true
TELEFLOW_EXECUTION_SITE_KEY=primary
TELEFLOW_EXECUTION_SITE_NAME=Основная площадка
TELEFLOW_EXECUTION_PRIMARY_SITE_KEY=primary
TELEFLOW_EXECUTION_LEASE_TTL_SECONDS=45
TELEFLOW_EXECUTION_SITE_HEARTBEAT_TTL_SECONDS=90
TELEFLOW_EXECUTION_REQUIRE_DISTINCT_FAILOVER_APPROVER=true

# Continuity Assurance 2.4 (обязательно в production)
TELEFLOW_CONTINUITY_ASSURANCE_REQUIRED=true
TELEFLOW_CONTINUITY_REQUIRE_DISTINCT_SIGNOFF=true
TELEFLOW_CONTINUITY_DEFAULT_REQUIRE_LIVE_DRILL=true
TELEFLOW_CONTINUITY_DEFAULT_MAX_RTO_SECONDS=300
TELEFLOW_CONTINUITY_DEFAULT_EVIDENCE_VALID_DAYS=30
TELEFLOW_CONTINUITY_SYNC_INTERVAL_SECONDS=15
TELEFLOW_COOKIE_SECURE=true
TELEFLOW_COOKIE_SAMESITE=strict
TELEFLOW_CORS_ORIGINS=https://panel.example.com
TELEFLOW_ALLOWED_HOSTS=panel.example.com,api,nginx
TELEFLOW_TRUST_PROXY_HEADERS=true
TELEFLOW_IP_ALLOWLIST=
TELEFLOW_USE_REDIS_LOCKS=true
TELEFLOW_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
TELEFLOW_STORAGE_BACKEND=local
TELEFLOW_STORAGE_PATH=/app/storage
TELEFLOW_ANTIVIRUS_MODE=disabled
TELEFLOW_ANTIVIRUS_FAIL_CLOSED=true
TELEFLOW_CLAMAV_HOST=clamav
TELEFLOW_CLAMAV_PORT=3310
TELEFLOW_CLAMAV_TIMEOUT_SECONDS=8
TELEFLOW_LOG_FORMAT=json
TELEFLOW_METRICS_ENABLED=true
TELEFLOW_SENTRY_DSN=
TELEFLOW_OTEL_ENABLED=false
TELEFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
TELEFLOW_HTTP_PORT=8080

# Pilot Certification 1.5
TELEFLOW_PREFLIGHT_TTL_MINUTES=60
TELEFLOW_PERMISSION_EXPIRY_WARNING_DAYS=14
TELEFLOW_DESTINATION_VALIDATION_TTL_HOURS=168
TELEFLOW_CONNECTION_HEALTH_TTL_HOURS=24
TELEFLOW_READINESS_TTL_MINUTES=30
TELEFLOW_COMMISSIONING_TTL_MINUTES=30
TELEFLOW_CHANGE_VERIFICATION_TTL_MINUTES=30
TELEFLOW_PILOT_READINESS_REQUIRED=true
TELEFLOW_PILOT_STAGED_THRESHOLD=5
TELEFLOW_PILOT_STAGE_ENFORCEMENT_REQUIRED=true
TELEFLOW_PILOT_STAGE_ASSESSMENT_TTL_MINUTES=30
TELEFLOW_PILOT_CANARY_COOLDOWN_HOURS=24
TELEFLOW_PILOT_CANARY_VALID_HOURS=168
TELEFLOW_PILOT_RUN_EVIDENCE_MAX_AGE_DAYS=30
TELEFLOW_PILOT_MAX_FAILURE_PERCENT=10
TELEFLOW_SUPPORT_BUNDLE_TTL_HOURS=24
TELEFLOW_ARTIFACT_SIGNATURE_POLICY=require_trusted
TELEFLOW_REQUIRE_TRUSTED_RELEASE_ATTESTATION=true
TELEFLOW_REQUIRE_RELEASE_TRANSPARENCY=true
TELEFLOW_REQUIRE_DEPENDENCY_ASSESSMENT=true
TELEFLOW_DEPENDENCY_ASSESSMENT_TTL_HOURS=24
TELEFLOW_DEPENDENCY_REQUIRE_VULNERABILITY_SCAN=true
TELEFLOW_DEPENDENCY_REQUIRE_TRUSTED_REPORT=true
TELEFLOW_DEPENDENCY_REPORT_MAX_BYTES=5242880

# Operational SLO & Incident Assurance 2.2
TELEFLOW_SLO_GATE_REQUIRED=true
TELEFLOW_SLO_AUTO_EVALUATE_MINUTES=15
TELEFLOW_SLO_ASSESSMENT_TTL_MINUTES=30
TELEFLOW_SLO_DEFAULT_EVALUATION_WINDOW_HOURS=24
TELEFLOW_SLO_DEFAULT_DELIVERY_SUCCESS_TARGET_BPS=9900
TELEFLOW_SLO_DEFAULT_MINIMUM_DELIVERY_SAMPLE_SIZE=10
TELEFLOW_SLO_DEFAULT_MAX_QUEUE_AGE_SECONDS=900
TELEFLOW_SLO_DEFAULT_MAX_WORKER_HEARTBEAT_AGE_SECONDS=120
TELEFLOW_SLO_DEFAULT_MAX_UNRESOLVED_DELIVERY_REVIEWS=0
TELEFLOW_SLO_DEFAULT_MAX_OPEN_CRITICAL_INCIDENTS=0
TELEFLOW_SLO_DEFAULT_ERROR_BUDGET_WARNING_PERCENT=50
TELEFLOW_SLO_DEFAULT_ERROR_BUDGET_CRITICAL_PERCENT=100

# Capacity & Backpressure Assurance 2.5
TELEFLOW_CAPACITY_ASSURANCE_REQUIRED=true
TELEFLOW_CAPACITY_AUTO_EVALUATE_MINUTES=5
TELEFLOW_CAPACITY_ASSESSMENT_TTL_MINUTES=15
TELEFLOW_CAPACITY_DEFAULT_MAX_ACTIVE_JOBS=500
TELEFLOW_CAPACITY_DEFAULT_MAX_READY_JOBS=100
TELEFLOW_CAPACITY_DEFAULT_MAX_PROCESSING_JOBS=5
TELEFLOW_CAPACITY_DEFAULT_MAX_ACTIVE_RUNS=20
TELEFLOW_CAPACITY_DEFAULT_MAX_JOBS_PER_RUN=100
TELEFLOW_CAPACITY_DEFAULT_MAX_NETWORK_STARTS_PER_MINUTE=30
TELEFLOW_CAPACITY_DEFAULT_MAX_NETWORK_STARTS_PER_HOUR=500
TELEFLOW_CAPACITY_DEFAULT_MAX_ESTIMATED_DRAIN_SECONDS=21600
TELEFLOW_CAPACITY_DEFAULT_WARNING_UTILIZATION_PERCENT=70
TELEFLOW_CAPACITY_DEFAULT_ADMISSION_BLOCK_UTILIZATION_PERCENT=90
TELEFLOW_CAPACITY_RETRY_DELAY_SECONDS=15

# Recovery Assurance 1.8 (required in production)
TELEFLOW_RECOVERY_DEFAULT_RPO_HOURS=24
TELEFLOW_RECOVERY_DEFAULT_RTO_MINUTES=60
TELEFLOW_RECOVERY_DEFAULT_DRILL_MAX_AGE_DAYS=30
TELEFLOW_RECOVERY_DEFAULT_MINIMUM_RETAINED_BACKUPS=3
TELEFLOW_RECOVERY_EVIDENCE_RETENTION_DAYS=365
TELEFLOW_RECOVERY_REQUIRE_ENCRYPTED_BACKUP=true
TELEFLOW_RECOVERY_REQUIRE_TRUSTED_SIGNATURE=true
TELEFLOW_RECOVERY_AGE_RECIPIENT=age1CHANGE_ME
# Mount this file read-only only for manual verify/drill commands; do not store it with backups.
TELEFLOW_RECOVERY_AGE_IDENTITY_FILE=/run/secrets/teleflow_age_identity
